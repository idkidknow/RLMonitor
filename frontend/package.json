{
  "name": "rlmonitor-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "format": "prettier --write src public index.html vite.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "format:check": "prettier --check src public index.html vite.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "test": "node --test --test-isolation=none src/lib.test.ts",
    "build": "pnpm check && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-solid": "1.50.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-solid": "2.11.14"
  }
}
